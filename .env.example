# Active provider: azure_openai | openai | anthropic | google
PROVIDER=azure_openai

# AzureOpenAI (uses DefaultAzureCredential — no API key required)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_VERSION=2024-02-01
AZURE_LLM_DEPLOYMENT_NAME=gpt-4.1
AZURE_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Optional: explicit index path (if multiple .pkl files in indexes/)
INDEX_PATH=

# Optional: comma-separated CORS origins for the FastAPI server
# CORS_ORIGINS=http://localhost:5174
